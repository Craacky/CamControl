<Window x:Class="CC.UI.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:common="clr-namespace:CC.UI.Controls.Common"
        xmlns:windows="clr-namespace:CC.UI.ViewModels.Windows"
        xmlns:wc="http://schemas.microsoft.com/winfx/2006/xaml/presentation/shell"
        Height="760"
        d:DataContext="{d:DesignInstance Type=windows:MainWindowViewModel,
                                     IsDesignTimeCreatable=False}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#03045e"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        AllowsTransparency="False"
        mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CC.UI;component/Styles/Common.xaml" />
                <ResourceDictionary Source="/CC.UI;component/Styles/Border.xaml" />
                <ResourceDictionary Source="/CC.UI;component/Styles/Button.xaml" />
                <ResourceDictionary Source="/CC.UI;component/Styles/TextBlock.xaml" />
                <ResourceDictionary Source="/CC.UI;component/Styles/TextBox.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                         ResizeBorderThickness="0"
                         GlassFrameThickness="0"
                         CornerRadius="15"/>
    </WindowChrome.WindowChrome>


    <Border Padding="0" Margin="0" Background="#03045e" SnapsToDevicePixels="True">

        <Grid Background="#03045e" SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0"
                    Background="#03045e"
                    CornerRadius="0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding SettingsService.Settings.Line.FullName, UpdateSourceTrigger=PropertyChanged, StringFormat=Линия : {0}}"
                               Foreground="White"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0 0  0 5"
                               FontSize="18" />

                    <!-- Title buttons removed per request -->
                </Grid>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar (menu only) -->
                <Grid Grid.Column="0">
                    <common:MainWindowMenuControl />
                </Grid>

                <!-- Right Content with blue frame and inner rounding -->
                <Border Grid.Column="1" Style="{StaticResource ContentFrameBorderStyle}">
                    <ContentControl Content="{Binding Navigator.CurrentViewModel}" />
                </Border>
            </Grid>
        </Grid>
    </Border>
    
</Window>