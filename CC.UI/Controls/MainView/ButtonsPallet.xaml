<UserControl x:Class="CC.UI.Controls.MainView.ButtonsPallet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CC.UI.Controls.MainView"
             xmlns:mainWindow="clr-namespace:CC.UI.ViewModels.MainWindow"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=mainWindow:MainViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/Button.xaml" />
                <ResourceDictionary Source="../../Styles/Border.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Border Style="{StaticResource ButtonsBorderStyle}">
        <UniformGrid Grid.Row="0"
                     Rows="2">
            <Button Content="Закрыть паллету"
                    Style="{StaticResource SecondaryButtonStyle}" 
                    Command="{Binding ClosePalletCommand}"/>
            <Button Content="Добавить к &#10;пред. паллете"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding AddBoxesToPreviousPalletCommand}"/>
        </UniformGrid>
    </Border>
</UserControl>