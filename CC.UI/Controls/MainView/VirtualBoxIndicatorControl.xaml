<UserControl x:Class="CC.UI.Controls.MainView.VirtualBoxIndicatorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mainWindow="clr-namespace:CC.UI.ViewModels.MainWindow"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=mainWindow:MainViewModel, IsDesignTimeCreatable=False}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CC.UI;component/Styles/TextBlock.xaml" />
                <ResourceDictionary Source="/CC.UI;component/Styles/Border.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource ControlBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource TableHeaderBorderStyle}">
                <TextBlock Text="Виртуальные короба" Style="{StaticResource HeaderTextBlockStyle}" />
            </Border>

            <StackPanel Grid.Row="1" Margin="10" VerticalAlignment="Center">
                <TextBlock Text="Активные:" Style="{StaticResource HeaderFieldTextBlockStyle}" />
                <TextBlock Text="{Binding ActiveVirtualBoxesCount, UpdateSourceTrigger=PropertyChanged}"
                           FontSize="26"
                           HorizontalAlignment="Left"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>