<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:viewmodels="clr-namespace:CC.UI.ViewModels.Main"
                    xmlns:main="clr-namespace:CC.UI.Views.Main"
                    xmlns:aggregation="clr-namespace:CC.UI.Views.Aggregation"
                    xmlns:viewmodels1="clr-namespace:CC.UI.ViewModels.Aggregation"
                    xmlns:settings="clr-namespace:CC.UI.Views.Settings"
                    xmlns:settings1="clr-namespace:CC.UI.ViewModels.Settings">
    
    <DataTemplate DataType="{x:Type viewmodels:MainViewModel}">
        <main:MainView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels:ReportTasksViewModel}">
        <main:ReportTasksView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels:AggregationViewModel}">
        <main:AggregationView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels1:AddProductAggregationViewModel}">
        <aggregation:AddProductAggregationView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels1:DeleteProductAggregationViewModel}">
        <aggregation:DeleteProductAggregationView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels1:AddBoxAggregationViewModel}">
        <aggregation:AddBoxAggregationView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels1:DeleteBoxAggregationViewModel}">
        <aggregation:DeleteBoxAggregationView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels1:AddPalletAggregationViewModel}">
        <aggregation:AddPalletAggregationView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels1:DeletePalletAggregationViewModel}">
        <aggregation:DeletePalletAggregationView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels1:CheckCodeAggregationViewModel}">
        <aggregation:CheckCodeAggregationView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels:ErrorsViewModel}">
        <main:ErrorsView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
        <main:SettingsView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type settings1:LineViewModel}">
        <settings:LineView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type settings1:CamerasViewModel}">
        <settings:CamerasView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type settings1:PrinterViewModel}">
        <settings:PrinterView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type settings1:DataBaseViewModel}">
        <settings:DataBaseView/>
    </DataTemplate>


    <Style x:Key="DatePickerStyle" TargetType="DatePicker">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="Gray"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="10 10"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Margin" Value="10 5"/>
        <Setter Property="BorderBrush" Value="DarkGray"/>
        <Setter Property="Border.CornerRadius" Value="5"/>
    </Style>

    <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="10 10"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="BorderBrush" Value="#DBE2FF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="Gray"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="5 5"/>
    </Style>





    <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="Gray"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Border.CornerRadius" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="10 10"/>
        <Setter Property="Margin" Value="10 5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Border.CornerRadius" Value="0"/>
        <Setter Property="BorderBrush" Value="LightGray"/>
    </Style>



    <Style x:Key="ReportTasksTableBorder" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="LightGray"/>
        <Setter Property="BorderThickness" Value="0.6"/>
        <Setter Property="Padding" Value="0 0"/>
        <Setter Property="Margin" Value="0 5"/>
        <Setter Property="CornerRadius" Value="5"/>
    </Style>

    <Style x:Key="ListBoxHeaderBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{x:Null}"/>
        <Setter Property="BorderThickness" Value="5 0 0 0"/>
        <Setter Property="Padding" Value="5 5"/>
        <Setter Property="Margin" Value="0 0"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <Style x:Key="ReportTasksButtonsBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{x:Null}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="5 5"/>
        <Setter Property="Margin" Value="0 0"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <!--ReportTasksView-->
    <Style x:Key="DeviceBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="LightGray"/>
        <Setter Property="BorderThickness" Value="0.7"/>
        <Setter Property="Padding" Value="5 5"/>
        <Setter Property="Margin" Value="5 5"/>
        <Setter Property="CornerRadius" Value="5"/>
    </Style>
</ResourceDictionary>